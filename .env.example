# MatchTable environment variables
# Copy to repo root `.env` (and optionally `apps/web/.env`, `apps/dashboard/.env`).
# Server-side vars are read at build/runtime; VITE_* vars are exposed to the browser.

# --- Server (required: apps/web + apps/dashboard) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Service role key — required for admin dashboard server functions only
# (user ban/unban, cross-user queries). Never expose to the client or VITE_*.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Public (required: browser Supabase client in both apps) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
