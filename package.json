{
  "name": "matchtable",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp check && vp run build",
    "dev": "vp run @matchtable/web#dev",
    "dev:web": "vp run @matchtable/web#dev",
    "dev:dashboard": "vp run @matchtable/dashboard#dev",
    "build": "vp run --filter @matchtable/web build",
    "preview": "vp preview apps/web",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "fmt": "vp fmt",
    "lint": "vp lint --type-aware --type-check",
    "lint:fix": "vp lint --type-aware --type-check --fix",
    "db:link": "supabase link",
    "db:push": "supabase db push",
    "db:migrations": "node scripts/list-migrations.mjs"
  },
  "devDependencies": {
    "@tanstack/eslint-plugin-query": "5.101.0",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "supabase": "2.106.0",
    "vite-plus": "0.1.24"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.5.3"
}
